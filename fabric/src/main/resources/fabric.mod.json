{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["net.tapacywka.aacs.fabric.AacsFabric"],
    "modmenu": ["net.tapacywka.aacs.fabric.AacsModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}
