{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://github.com/Tapacywka/actually-amazing-config-screen",
    "sources": "https://github.com/Tapacywka/actually-amazing-config-screen",
    "issues": "https://github.com/Tapacywka/actually-amazing-config-screen/issues"
  },
  "license": "${mod_license}",
  "icon": "aacs.png",
  "environment": "*",
  "accessWidener": "aacs.classtweaker",
  "entrypoints": {
    "main": ["net.tapacywka.aacs.fabric.AacsFabric"],
    "modmenu": ["net.tapacywka.aacs.fabric.AacsModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}
